# Copy to .env for local development. On Unraid these become container variables.

# --- server ---------------------------------------------------------------
PORT=8080
DATA_DIR=./data
PROPERTY_NAME=Wealwandangie

# Where the map opens on a fresh install, before any paddocks exist. Once
# the map has paddocks it fits to them instead.
MAP_CENTRE_LAT=-24.1
MAP_CENTRE_LON=148.1
MAP_ZOOM=11

# Imagery tiles cached on disk are refetched after this many days, which is
# how newer QLD imagery eventually appears. 0 keeps them forever.
TILE_MAX_AGE_DAYS=180

TZ=Australia/Brisbane
LOG_LEVEL=info

# --- accounts -------------------------------------------------------------
# Require a login. Leave this on.
REQUIRE_AUTH=true
SESSION_DAYS=60

# The first-run page creates the administrator, so whoever reaches it first
# owns the app. Restricting it to the local network means a tunnel that goes
# live before anyone has signed up cannot be claimed by a stranger.
SETUP_LAN_ONLY=true
# Or supply this as ?setup_token=... to do it remotely. Generate with:
#   openssl rand -hex 32
#SETUP_TOKEN=

# --- publishing through Cloudflare ---------------------------------------
# Which upstream addresses may set X-Forwarded-For / X-Forwarded-Proto.
TRUSTED_PROXIES=loopback,uniquelocal

# Cloudflare Access team name and the Application Audience tag. With both set,
# every request from outside the LAN must carry a verified Access token.
#CF_ACCESS_TEAM_DOMAIN=yourteam
#CF_ACCESS_AUD=

# Refuse non-LAN requests that have not been through Access. Fails closed.
CF_ACCESS_REQUIRED=true

#TRUSTED_ORIGINS=grazing.example.com

# --- backups ---------------------------------------------------------------
# The database copies itself into DATA_DIR/backups every night at this hour
# (local time), keeping this many. Also runs at start-up if today has none.
BACKUP_HOUR=2
BACKUP_KEEP=30
